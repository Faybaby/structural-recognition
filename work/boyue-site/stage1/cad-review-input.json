  "rules": [
    {
      "id": "CR01",
      "title": "原阴线优先",
      "text": "按原阴线分段；分割位置属于阴线的，仍按阴线计算。",
      "handles": [
        "1B6D",
        "4D9B"
      ]
    },
    {
      "id": "CR02",
      "title": "阴线窄段免放",
      "text": "阴线分出的WN≤200mm窄段免放；普通等宽200mm梁保留原规则。",
      "handles": [
        "4D09",
        "5C9A",
        "6C2C",
        "6C2D"
      ]
    },
    {
      "id": "CR03",
      "title": "企口合并后的截面",
      "text": "梁宽按合并后的实体宽；查表梁高＝楼层标高−主梁底标高，几何企口及上翻仍保留。",
      "handles": [
        "260C",
        "29C3"
      ]
    },
    {
      "id": "CR04",
      "title": "普通梁端余量",
      "text": "固定XX，H1/H2尽量均分，允许＜500mm；仍要求0＜H＜XX−100。楼面和GL算法保留。",
      "handles": [
        "2A28",
        "2AD0",
        "2B3C",
        "2B94",
        "2BAE"
      ]
    },
    {
      "id": "CR05",
      "title": "弧直分段",
      "text": "按三维真实相切位置拆分计算段；新增弧直计算端按GLL1处理，原有阴线保持。",
      "handles": [
        "2F46",
        "3EED",
        "6F46",
        "760E",
        "760F",
        "7610",
        "76EE",
        "76EF"
      ]
    },
    {
      "id": "CR06",
      "title": "圆弧等分",
      "text": "圆弧先居中1点，按真实中心线弧长检查YH1/YH2≤XX；不足则3段及更多等分补点。弧点不强行移动到直线50模数。",
      "handles": [
        "64FE",
        "7278"
      ]
    },
    {
      "id": "CR07",
      "title": "阳线端距",
      "text": "80≤GW1≤150：GLL1=100～130；GW1＞150：50～80，优先50；直线沿轴距所选基准为50mm倍数。",
      "handles": [
        "3067",
        "7025",
        "7BE3",
        "99EE"
      ]
    },
    {
      "id": "CR08",
      "title": "变宽分割与交点",
      "text": "先按实际边界分割，确定端部、计算中间GTT，再找真实交点；梁高差≥100不放交点。",
      "handles": [
        "37C8",
        "7AC2",
        "880E",
        "9ACB"
      ]
    },
    {
      "id": "CR09",
      "title": "斜梁独立基准",
      "text": "识别三维平行边及CAD补充轴线；斜梁基准单独确认，未确认不生成正式点位。",
      "handles": [
        "9C31",
        "9253"
      ]
    }
